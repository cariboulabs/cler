[Unit]
Description=cler websdr browser receiver
After=network.target

[Service]
User=websdr
Group=plugdev
EnvironmentFile=-/etc/default/cler-websdr
ExecStart=/usr/local/bin/websdr --state-file /var/lib/cler-websdr/state.json --record-dir /var/lib/cler-websdr $WEBSDR_ARGS
StateDirectory=cler-websdr
Type=notify
WatchdogSec=30
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
